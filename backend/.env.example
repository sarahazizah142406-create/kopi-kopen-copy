PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kopi_kopen

# URL publik server ini (untuk generate link gambar)
APP_URL=http://192.168.1.29:3000

# Path ke folder uploads dari project kopi-kopen (web)
# Windows contoh : C:/xampp/htdocs/kopi-kopen/uploads
# Linux/Mac contoh: /var/www/html/kopi-kopen/uploads
# Relatif        : ../kopi-kopen/uploads  (kalau dua folder sejajar)
UPLOADS_DIR=C:/xampp/htdocs/kopi-kopen/uploads
